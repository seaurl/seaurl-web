AUTH_SECRET=
# 设置signOut()退出登录时的跳转页面，不加的话则跳转到localhost:3000
NEXTAUTH_URL=http://localhost:3000

# 必须要加NEXT_PUBLIC前缀否则不起作用
NEXT_PUBLIC_SCENE_ID=

NEXT_PUBLIC_HOST=http://localhost:3000
#这里注意一下，因为后台使用了/api和next-auth的/api/auth冲突了，所以要特别设置一下，详情请看Caddy文件
NEXT_PUBLIC_API_HOST=http://localhost:7777/api
NEXT_PUBLIC_WEBSOCKET_HOST=ws://localhost:7777/api
NEXT_PUBLIC_WEATHER_FREE_HOST=https://devapi.qweather.com
NEXT_PUBLIC_WEATHER_STANDARD_HOST=https://api.qweather.com
